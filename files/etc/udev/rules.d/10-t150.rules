# Model-specific paths also cover a wheel already switched by hid-thrustmaster.
ACTION=="add", SUBSYSTEM=="input", ATTRS{idVendor}=="044f", ATTRS{idProduct}=="b677", ENV{ID_INPUT_JOYSTICK}="1", TAG+="uaccess"
ACTION=="add", SUBSYSTEM=="input", ATTRS{idVendor}=="044f", ATTRS{idProduct}=="b67f", ENV{ID_INPUT_JOYSTICK}="1", TAG+="uaccess"
ACTION=="bind", SUBSYSTEM=="hid", DRIVER=="hid-generic", KERNEL=="0003:044F:B677.*", RUN+="/usr/lib/udev/hid-t150-rebind %k --udev"
ACTION=="bind", SUBSYSTEM=="hid", DRIVER=="hid-generic", KERNEL=="0003:044F:B67F.*", RUN+="/usr/lib/udev/hid-t150-rebind %k --udev"
